# 服务
NODE_ENV=development
PORT=3000

# 数据库
DATABASE_URL=postgresql://family:family@localhost:5432/family_ordering

# 会话签名密钥（生产必须改成随机长字符串）
FAMILY_JWT_SECRET=dev-secret-change-me
FAMILY_JWT_EXPIRES_IN=30d

# 跨域来源（生产填前端域名，多个用逗号分隔）
CORS_ORIGIN=*

# 微信小程序（用 /auth/wechat 时必填；开发可用测试号凭据）
WECHAT_APPID=
WECHAT_SECRET=
