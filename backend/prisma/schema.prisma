// 家庭点菜程序数据模型
// 多租户：业务表统一挂 family_id，service 层强制按家庭过滤。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

/// 全局账号（钉钉式：人与家庭分离，一个账号可属多个家庭）
model User {
  id           String         @id @default(cuid())
  username     String         @unique
  /// 微信小程序 openid；密码登录用户为空
  openid       String?        @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  memberships  FamilyMember[]
}

/// 家庭（租户）
model Family {
  id             String        @id @default(cuid())
  name           String
  /// 口令的 SHA-256，用于全局唯一与按口令查找（bcrypt 加盐无法直接查询）
  passphraseKey  String        @unique
  passphraseHash String
  createdAt      DateTime      @default(now())
  members        FamilyMember[]
  meals          Meal[]
  categories     Category[]
  dishes         Dish[]
  mealOrders     MealOrder[]
}

/// 家庭成员档案：用户在某家庭内的昵称/头像/角色
model FamilyMember {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  nickname  String
  avatar    String   @default("😊")
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  family Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  OrderItem[]

  @@unique([familyId, userId])
  @@unique([familyId, nickname])
  @@index([familyId])
}

/// 餐次配置：名称 + 时间窗（HH:mm），允许跨午夜（end < start）
model Meal {
  id        String   @id @default(cuid())
  familyId  String
  name      String
  startTime String   @db.Char(5)
  endTime   String   @db.Char(5)
  sort      Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  family     Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  mealOrders MealOrder[]

  // 名称唯一性在 service 层按「启用中」校验：停用（软删）后可复用同名
  @@index([familyId])
}

/// 菜品分类
model Category {
  id       String   @id @default(cuid())
  familyId String
  name     String
  sort     Int      @default(0)
  dishes   Dish[]

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, name])
  @@index([familyId])
}

/// 菜品
model Dish {
  id          String   @id @default(cuid())
  familyId    String
  categoryId  String
  name        String
  description String?
  imageUrl    String?
  sort        Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family   Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  items    OrderItem[]

  @@unique([familyId, categoryId, name])
  @@index([familyId])
}

/// 餐次单：每天每餐次一张，惰性创建
model MealOrder {
  id        String   @id @default(cuid())
  familyId  String
  mealDate  DateTime @db.Date
  mealId    String
  createdAt DateTime @default(now())

  family Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  meal   Meal        @relation(fields: [mealId], references: [id], onDelete: Restrict)
  items  OrderItem[]

  @@unique([familyId, mealDate, mealId])
  @@index([familyId, mealDate])
}

/// 点菜项：dish_name 为快照（自定义菜 / 菜库改名不影响历史单）
model OrderItem {
  id          String   @id @default(cuid())
  mealOrderId String
  memberId    String
  dishId      String?
  dishName    String
  qty         Int      @default(1)
  struck      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mealOrder MealOrder    @relation(fields: [mealOrderId], references: [id], onDelete: Cascade)
  member    FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  dish      Dish?        @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@unique([mealOrderId, memberId, dishName])
  @@index([mealOrderId])
}
